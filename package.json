{
  "name": "awapi-editor",
  "version": "0.4.0",
  "description": "A fast, lightweight, universal text editor",
  "main": "dist/main/main.js",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "cross-env NODE_ENV=production vite build",
    "package": "cross-env NODE_ENV=production vite build && electron-builder",
    "release": "cross-env NODE_ENV=production vite build && electron-builder --publish always",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.js",
    "postinstall": "node scripts/fix-node-pty-permissions.js"
  },
  "build": {
    "appId": "com.awapi.awapieditor",
    "publish": [
      "github"
    ],
    "productName": "AwapiEditor",
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "msi"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon-512x512.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "maintainer": "awapi <oyesil@gmail.com>"
    },
    "files": [
      "dist/**/*",
      "build/**/*"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awapi/awapi-editor.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/awapi/awapi-editor/issues"
  },
  "homepage": "https://github.com/awapi/awapi-editor#readme",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "node-pty",
      "sharp"
    ]
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.55.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.4",
    "wait-on": "^9.5.1"
  }
}
